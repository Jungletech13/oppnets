{
  "name": "oppnets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e --host 127.0.0.1 --port 4173",
    "build": "npm run typecheck && vite build",
    "check": "npm run typecheck && npm run lint && npm test && vite build",
    "check:all": "npm run check && npm run test:e2e",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "qa:persona-validate": "node qa/persona-lab/validate.mjs",
    "qa:persona-pilot": "node qa/persona-lab/pilot-runner.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.10"
  }
}
